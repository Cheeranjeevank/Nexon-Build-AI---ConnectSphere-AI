# =================================================================
# ConnectSphere - AI-Powered Community Connect
# Environment Configuration Template
# =================================================================

# -----------------------------------------------------------------
# 1. Backend Server Configuration (backend/.env)
# -----------------------------------------------------------------
PORT=5001
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/connectsphere

# JWT Authentication Secret Key
JWT_SECRET=connectsphere-super-secure-jwt-key-2026

# Nexconn Chat Server Credentials (From https://console.nexconn.ai/agile/apps/km)
# CRITICAL: App Secret must ONLY reside on the backend server.
NEXCONN_APP_KEY=YOUR_NEXCONN_APP_KEY
NEXCONN_APP_SECRET=YOUR_NEXCONN_APP_SECRET
# Base API URL:
# Singapore (Default / Global): https://api.sg-light-api.com
# North America: https://api.us-light-api.com
NEXCONN_API_BASE_URL=https://api.sg-light-api.com

# Google Gemini API Key (Optional: Powers SphereAI Copilot & Smart Moderation)
# If omitted, ConnectSphere automatically runs on its built-in heuristic NLP engine.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------
# 2. Frontend Web Configuration (frontend/.env)
# -----------------------------------------------------------------
VITE_API_URL=/api
# Public App Key for client SDK initialization (Never put App Secret here!)
VITE_NEXCONN_APP_KEY=YOUR_NEXCONN_APP_KEY

