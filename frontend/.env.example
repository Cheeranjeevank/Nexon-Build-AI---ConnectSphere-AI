# ConnectSphere Frontend Environment Variables

# Backend API proxy URL (defaults to /api which proxies to http://localhost:5001)
VITE_API_URL=/api

# Nexconn Chat Public App Key (From https://console.nexconn.ai/agile/apps/km)
# NOTE: Never put App Secret in frontend! Only public App Key is exposed here.
VITE_NEXCONN_APP_KEY=YOUR_NEXCONN_APP_KEY

