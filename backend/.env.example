# ConnectSphere Server Environment Variables

# Server Configuration
PORT=5001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/connectsphere

# JWT Authentication
JWT_SECRET=connectsphere-super-secure-jwt-key-2026

# Nexconn Chat Server Credentials (From https://console.nexconn.ai/agile/apps/km)
# The App Secret must NEVER be exposed to the client.
NEXCONN_APP_KEY=YOUR_NEXCONN_APP_KEY
NEXCONN_APP_SECRET=YOUR_NEXCONN_APP_SECRET
# Base URLs: Singapore (api.sg-light-api.com) or North America (api.us-light-api.com)
NEXCONN_API_BASE_URL=https://api.sg-light-api.com

# Google Gemini API (Optional, provides AI Community Assistant & Smart Moderation)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash

